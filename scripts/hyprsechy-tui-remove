#!/bin/bash

# Hyprsechy TUI Removal Script
# Based on omarchy-tui-remove pattern

set -e

ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_DIR="$HOME/.local/share/applications"

# Hyprsechy TUI names
HYPRSECHY_TUIS=(
    "Hyprsechy Session Restore"
    "Hyprsechy Config"
)

# Function to remove a TUI
remove_tui() {
    local app_name="$1"
    local desktop_file="$DESKTOP_DIR/$app_name.desktop"
    local icon_file="$ICON_DIR/$app_name.png"

    if [[ -f "$desktop_file" ]]; then
        rm -f "$desktop_file"
        echo "✓ Removed desktop entry: $app_name"
    fi

    if [[ -f "$icon_file" ]]; then
        rm -f "$icon_file"
        echo "✓ Removed icon: $app_name"
    fi
}

# Check if gum is available for interactive selection
if command -v gum &> /dev/null && [ "$#" -eq 0 ]; then
    echo "Finding Hyprsechy TUI applications..."

    # Find existing Hyprsechy TUIs
    EXISTING_TUIS=()
    for tui_name in "${HYPRSECHY_TUIS[@]}"; do
        if [[ -f "$DESKTOP_DIR/$tui_name.desktop" ]]; then
            EXISTING_TUIS+=("$tui_name")
        fi
    done

    if [[ ${#EXISTING_TUIS[@]} -eq 0 ]]; then
        echo "No Hyprsechy TUI applications found to remove."
        exit 0
    fi

    echo "Select Hyprsechy TUI applications to remove:"
    SELECTED_TUIS=$(gum choose --no-limit --header "Select TUI to remove..." --selected-prefix="✗ " "${EXISTING_TUIS[@]}")

    if [[ -z "$SELECTED_TUIS" ]]; then
        echo "No TUIs selected for removal."
        exit 0
    fi

    # Remove selected TUIs
    while IFS= read -r tui_name; do
        [[ -n "$tui_name" ]] && remove_tui "$tui_name"
    done <<< "$SELECTED_TUIS"

elif [ "$#" -eq 0 ]; then
    # No gum available, remove all Hyprsechy TUIs
    echo "Removing all Hyprsechy TUI applications..."

    REMOVED_COUNT=0
    for tui_name in "${HYPRSECHY_TUIS[@]}"; do
        if [[ -f "$DESKTOP_DIR/$tui_name.desktop" ]]; then
            remove_tui "$tui_name"
            ((REMOVED_COUNT++))
        fi
    done

    if [[ $REMOVED_COUNT -eq 0 ]]; then
        echo "No Hyprsechy TUI applications found to remove."
    else
        echo "Removed $REMOVED_COUNT Hyprsechy TUI application(s)."
    fi

else
    # Remove specific TUIs provided as arguments
    for tui_name in "$@"; do
        remove_tui "$tui_name"
    done
fi

echo "Removal complete!"